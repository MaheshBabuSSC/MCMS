@{
    Layout = null;
    var email = Context.Session.GetString("MFA_Email") ?? ViewBag.Email ?? "";
    
    if (string.IsNullOrEmpty(email))
    {
        Context.Response.Redirect("/");
        return;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>OTP Verification | CMS</title>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: 'Segoe UI', system-ui, 'Inter', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
            background: #0a0c12;
            overflow: hidden;
            position: relative;
        }

        #bg-video {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -2;
            filter: brightness(0.5) blur(2px);
            transform: scale(1.02);
        }

        .overlay-dark {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.55);
            backdrop-filter: blur(4px);
            z-index: -1;
        }

        .otp-container {
            width: 100%;
            max-width: 500px;
            margin: 1.5rem;
            background: rgba(20, 22, 32, 0.75);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border-radius: 36px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 0 0.5px rgba(255, 255, 255, 0.05) inset;
            padding: 2rem 1.8rem 2.5rem;
            transition: all 0.3s ease;
            animation: floatIn 0.5s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        }

        @@keyframes floatIn {
            0% {
                opacity: 0;
                transform: translateY(30px) scale(0.96);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .logo-wrapper {
            display: flex;
            justify-content: center;
            margin-bottom: 1.2rem;
        }

        .logo-icon {
            background: rgba(0, 123, 255, 0.15);
            backdrop-filter: blur(4px);
            padding: 12px 18px;
            border-radius: 60px;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            border: 0.5px solid rgba(0, 123, 255, 0.3);
        }

        .logo-icon img {
            height: 38px;
            width: auto;
        }

        .logo-icon span {
            font-weight: 700;
            font-size: 1.5rem;
            letter-spacing: 1px;
            background: linear-gradient(135deg, #ffffff, #90caf9);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .otp-header {
            text-align: center;
            margin-bottom: 28px;
        }

        .otp-header h1 {
            font-size: 1.9rem;
            font-weight: 700;
            background: linear-gradient(120deg, #f0f9ff, #bfdbfe);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            letter-spacing: -0.3px;
        }

        .otp-header .sub {
            color: #b0b8d0;
            font-size: 0.9rem;
            margin-top: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        .email-highlight {
            background: #1e2a3e;
            padding: 4px 12px;
            border-radius: 30px;
            font-weight: 500;
            font-size: 0.85rem;
            color: #80b6ff;
            font-family: monospace;
            letter-spacing: 0.3px;
        }

        .otp-input-group {
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
            margin: 28px 0 18px;
        }

        .otp-digit {
            width: 58px;
            height: 70px;
            text-align: center;
            font-size: 2rem;
            font-weight: 600;
            background: #141824;
            border: 1.5px solid #2c3142;
            border-radius: 20px;
            color: #ffffff;
            font-family: 'Courier New', monospace;
            transition: all 0.2s;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
        }

        .otp-digit:focus {
            outline: none;
            border-color: #007bff;
            box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.3);
            background: #1b1f2c;
        }

        .otp-actions {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            flex-wrap: wrap;
            margin: 16px 0 28px;
            font-size: 0.85rem;
        }

        .timer-block {
            background: rgba(0,0,0,0.4);
            padding: 6px 12px;
            border-radius: 40px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #cbd5e6;
        }

        .timer-block span.material-symbols-outlined {
            font-size: 18px;
        }

        .countdown {
            font-weight: 700;
            color: #ffb347;
            font-size: 1rem;
            letter-spacing: 0.5px;
        }

        .resend-link {
            background: none;
            border: none;
            color: #3b82f6;
            font-weight: 600;
            cursor: pointer;
            padding: 6px 12px;
            border-radius: 28px;
            transition: all 0.2s;
            font-size: 0.85rem;
        }

        .resend-link:disabled {
            color: #5f6b8a;
            cursor: not-allowed;
            opacity: 0.6;
        }

        .resend-link:not(:disabled):hover {
            background: rgba(59,130,246,0.2);
            text-decoration: underline;
        }

        .verify-btn {
            width: 100%;
            background: linear-gradient(95deg, #007bff, #2b6eff);
            border: none;
            padding: 14px 0;
            border-radius: 50px;
            font-weight: 700;
            font-size: 1rem;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            cursor: pointer;
            transition: 0.2s;
            margin-top: 6px;
            margin-bottom: 24px;
            box-shadow: 0 6px 14px rgba(0, 123, 255, 0.3);
        }

        .verify-btn:hover {
            transform: translateY(-2px);
            background: linear-gradient(95deg, #0066e6, #1a5ed4);
            box-shadow: 0 12px 22px rgba(0, 123, 255, 0.4);
        }

        .verify-btn:active {
            transform: translateY(1px);
        }

        .verify-btn:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none;
        }

        .back-link {
            text-align: center;
            margin-top: 8px;
        }

        .back-link a {
            color: #9aa9c1;
            text-decoration: none;
            font-size: 0.85rem;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: 0.2s;
            cursor: pointer;
        }

        .back-link a:hover {
            color: white;
            gap: 8px;
        }

        .status-message {
            text-align: center;
            font-size: 0.8rem;
            padding: 8px;
            border-radius: 32px;
            margin-bottom: 12px;
            background: rgba(0,0,0,0.5);
            backdrop-filter: blur(2px);
        }

        .error-msg {
            color: #ff8a7a;
            background: rgba(255, 60, 60, 0.15);
        }

        .success-msg {
            color: #9bffb0;
            background: rgba(0, 200, 100, 0.1);
        }

        .spinner {
            width: 18px;
            height: 18px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-top-color: white;
            border-radius: 50%;
            animation: spin 0.6s linear infinite;
            display: inline-block;
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }

        @@keyframes shake {
            0% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            50% { transform: translateX(5px); }
            75% { transform: translateX(-3px); }
            100% { transform: translateX(0); }
        }

        @@media (max-width: 520px) {
            .otp-container {
                padding: 1.5rem;
            }
            .otp-digit {
                width: 48px;
                height: 60px;
                font-size: 1.8rem;
            }
            .otp-input-group {
                gap: 8px;
            }
        }

        @@media (max-width: 400px) {
            .otp-digit {
                width: 42px;
                height: 54px;
                font-size: 1.5rem;
            }
        }
    </style>
</head>
<body>
    <video autoplay muted loop id="bg-video">
        <source src="~/assets/bg-1.mp4" type="video/mp4">
    </video>
    <div class="overlay-dark"></div>

    <div class="otp-container">
        <div class="logo-wrapper">
            <div class="logo-icon">
                <img src="~/assets/Orbus_Logo.png" alt="Logo">
                <span>CMS</span>
            </div>
        </div>

        <div class="otp-header">
            <h1>Verify OTP</h1>
            <div class="sub">
                <span class="material-symbols-outlined" style="font-size: 18px;">mark_email_unread</span>
                <span>Enter the 6‑digit code sent to </span>
                <span id="userEmailDisplay" class="email-highlight">@email</span>
            </div>
        </div>

        <div class="otp-input-group" id="otpGroup">
            <input type="text" maxlength="1" class="otp-digit" id="digit1" autofocus>
            <input type="text" maxlength="1" class="otp-digit" id="digit2">
            <input type="text" maxlength="1" class="otp-digit" id="digit3">
            <input type="text" maxlength="1" class="otp-digit" id="digit4">
            <input type="text" maxlength="1" class="otp-digit" id="digit5">
            <input type="text" maxlength="1" class="otp-digit" id="digit6">
        </div>

        <div id="statusMessage" class="status-message"></div>

        <div class="otp-actions">
            <div class="timer-block">
                <span class="material-symbols-outlined">schedule</span>
                <span>Code expires in <span id="timerDisplay" class="countdown">02:00</span></span>
            </div>
            <button id="resendOtpBtn" class="resend-link">Resend Code</button>
        </div>

        <button id="verifyOtpBtn" class="verify-btn">
            Verify & Access
            <span class="material-symbols-outlined">login</span>
        </button>

        <div class="back-link">
            <a id="backToLoginBtn">
                <span class="material-symbols-outlined">arrow_back</span> Back to Login
            </a>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            var userEmail = "@email";
            var timerInterval = null;
            var timeLeft = 120;
            var isVerifying = false;
            
            $('#userEmailDisplay').text(userEmail);
            
            function setStatusMessage(msg, isError) {
                var $statusDiv = $('#statusMessage');
                $statusDiv.text(msg);
                $statusDiv.removeClass('success-msg error-msg').addClass(isError ? 'error-msg' : 'success-msg');
                setTimeout(function() {
                    if ($statusDiv.text() === msg) {
                        $statusDiv.text('').removeClass('success-msg error-msg');
                    }
                }, 3000);
            }
            
            function startTimer() {
                if (timerInterval) clearInterval(timerInterval);
                timerInterval = setInterval(function() {
                    if (timeLeft <= 0) {
                        clearInterval(timerInterval);
                        $('#timerDisplay').text('00:00');
                        setStatusMessage('OTP expired. Please request a new code.', true);
                        return;
                    }
                    timeLeft--;
                    var minutes = Math.floor(timeLeft / 60);
                    var seconds = timeLeft % 60;
                    $('#timerDisplay').text(minutes.toString().padStart(2, '0') + ':' + seconds.toString().padStart(2, '0'));
                }, 1000);
            }
            
            function resetTimer() {
                if (timerInterval) clearInterval(timerInterval);
                timeLeft = 120;
                startTimer();
            }
            
            function clearOtpInputs() {
                $('.otp-digit').val('');
                $('#digit1').focus();
            }
            
            function getEnteredOtp() {
                var code = '';
                $('.otp-digit').each(function() {
                    var val = $(this).val().trim();
                    if (val.length === 1 && /[0-9]/.test(val)) {
                        code += val;
                    }
                });
                return code;
            }
            
            // Verify OTP with jQuery AJAX
            $('#verifyOtpBtn').on('click', function() {
                if (isVerifying) return;
                
                var enteredOtp = getEnteredOtp();
                if (enteredOtp.length !== 6) {
                    setStatusMessage('Please enter a valid 6-digit OTP code.', true);
                    return;
                }
                
                if (timeLeft <= 0) {
                    setStatusMessage('OTP has expired. Please request a new code.', true);
                    return;
                }
                
                isVerifying = true;
                var $btn = $(this);
                $btn.html('<span class="spinner"></span> Verifying...');
                $btn.prop('disabled', true);
                
                $.ajax({
                    url: '/verify-mfa',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ otp: enteredOtp }),
                    success: function(data) {
                        if (data.success) {
                            setStatusMessage('Verification successful! Redirecting...', false);
                            if (timerInterval) clearInterval(timerInterval);
                            setTimeout(function() {
                                window.location.href = data.redirectUrl || '/Dashboard';
                            }, 1200);
                        } else {
                            setStatusMessage(data.message || 'Invalid OTP. Please try again.', true);
                            $btn.html('Verify & Access <span class="material-symbols-outlined">login</span>');
                            $btn.prop('disabled', false);
                            isVerifying = false;
                            $('#otpGroup').css('animation', 'shake 0.4s ease-in-out 0s 1');
                            setTimeout(function() { $('#otpGroup').css('animation', ''); }, 400);
                            setTimeout(function() { clearOtpInputs(); }, 300);
                        }
                    },
                    error: function() {
                        setStatusMessage('Something went wrong. Please try again.', true);
                        $btn.html('Verify & Access <span class="material-symbols-outlined">login</span>');
                        $btn.prop('disabled', false);
                        isVerifying = false;
                    }
                });
            });
            
            // Resend OTP with jQuery AJAX
            $('#resendOtpBtn').on('click', function() {
                var $btn = $(this);
                $btn.prop('disabled', true);
                $btn.text('Sending...');
                
                $.ajax({
                    url: '/resend-otp',
                    type: 'POST',
                    contentType: 'application/json',
                    success: function(data) {
                        if (data.success) {
                            resetTimer();
                            $('#verifyOtpBtn').prop('disabled', false);
                            $('#verifyOtpBtn').html('Verify & Access <span class="material-symbols-outlined">login</span>');
                            isVerifying = false;
                            clearOtpInputs();
                            setStatusMessage('New verification code sent!', false);
                            setTimeout(function() { 
                                $btn.text('Resend Code');
                                $btn.prop('disabled', false); 
                            }, 30000);
                        } else {
                            setStatusMessage(data.message || 'Failed to resend OTP', true);
                            $btn.text('Resend Code');
                            $btn.prop('disabled', false);
                        }
                    },
                    error: function() {
                        setStatusMessage('Something went wrong', true);
                        $btn.text('Resend Code');
                        $btn.prop('disabled', false);
                    }
                });
            });
            
            // Back to login
            $('#backToLoginBtn').on('click', function(e) {
                e.preventDefault();
                window.location.href = '/';
            });
            
            // OTP input navigation
            $('.otp-digit').on('input', function() {
                var val = $(this).val();
                if (val.length > 1) {
                    $(this).val(val.slice(0, 1));
                }
                if (val.length === 1) {
                    $(this).next('.otp-digit').focus();
                }
                $('#statusMessage').text('').removeClass('error-msg success-msg');
            });
            
            $('.otp-digit').on('keydown', function(e) {
                if (e.key === 'Backspace' && !$(this).val() && $(this).prev('.otp-digit').length) {
                    $(this).prev('.otp-digit').focus();
                }
                if (e.key === 'ArrowLeft' && $(this).prev('.otp-digit').length) {
                    $(this).prev('.otp-digit').focus();
                }
                if (e.key === 'ArrowRight' && $(this).next('.otp-digit').length) {
                    $(this).next('.otp-digit').focus();
                }
                if (e.key === 'Enter') {
                    $('#verifyOtpBtn').click();
                }
            });
            
            // Initialize
            startTimer();
            clearOtpInputs();
        });
    </script>
</body>
</html>