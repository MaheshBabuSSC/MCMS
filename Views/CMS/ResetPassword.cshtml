@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>MCMS • Reset Password</title>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                display: flex;
                justify-content: center;
                align-items: center;
                min-height: 100vh;
                font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, 'Roboto', sans-serif;
                background: #0a0c10;
                overflow: hidden;
                position: relative;
            }

            #bg-video {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                z-index: -2;
                filter: brightness(0.75) saturate(1.2);
            }

            .overlay-gradient {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.35);
                z-index: -1;
            }

            .reset-card {
                width: 100%;
                max-width: 520px;
                background: rgba(18, 22, 28, 0.55);
                backdrop-filter: blur(18px);
                -webkit-backdrop-filter: blur(18px);
                border-radius: 2rem;
                border: 1px solid rgba(255, 255, 255, 0.12);
                box-shadow: 0 30px 50px rgba(0, 0, 0, 0.6), 0 0 0 0.5px rgba(255, 255, 255, 0.05);
                padding: 2rem 2rem 2.2rem;
                transition: transform 0.3s ease;
                margin: 1.5rem;
                animation: gentleAppear 0.6s ease-out;
            }

                .reset-card:hover {
                    transform: translateY(-3px);
                }

            .header-center {
                text-align: center;
                margin-bottom: 2rem;
            }

            .brand-logo {
                display: flex;
                justify-content: center;
                align-items: center;
                margin-bottom: 1.2rem;
            }

                .brand-logo img {
                    height: 48px;
                    width: auto;
                    object-fit: contain;
                    filter: drop-shadow(0 2px 3px rgba(0,0,0,0.3));
                }

            .mcms-badge {
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 3px;
                font-weight: 500;
                color: #7c8ba0;
                margin-bottom: 0.5rem;
            }

            .reset-card h1 {
                font-size: 2rem;
                font-weight: 600;
                background: linear-gradient(135deg, #FFFFFF 0%, #c0d4ff 100%);
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
                letter-spacing: -0.3px;
                margin: 0.25rem 0 0.3rem;
            }

            .subhead {
                font-size: 0.9rem;
                color: #b9c3d4;
                margin-top: 6px;
            }

            .input-field {
                margin-bottom: 1.35rem;
                position: relative;
            }

                .input-field .material-symbols-outlined {
                    position: absolute;
                    left: 15px;
                    top: 50%;
                    transform: translateY(-50%);
                    font-size: 1.35rem;
                    color: #8f9bb3;
                    pointer-events: none;
                }

                .input-field input {
                    width: 100%;
                    background: rgba(10, 14, 19, 0.7);
                    border: 1px solid rgba(255, 255, 255, 0.15);
                    border-radius: 60px;
                    padding: 14px 20px 14px 48px;
                    font-size: 0.95rem;
                    font-weight: 500;
                    color: #f0f3fa;
                    outline: none;
                    transition: all 0.25s ease;
                    font-family: inherit;
                }

                    .input-field input:focus {
                        border-color: #3b82f6;
                        background: rgba(20, 28, 38, 0.95);
                        box-shadow: 0 0 0 3px rgba(59,130,246,0.25);
                    }

                    .input-field input::placeholder {
                        color: #7e8aa2;
                        font-weight: 400;
                    }

            .info-message {
                background: rgba(59,130,246,0.12);
                border-radius: 16px;
                padding: 12px 16px;
                margin-bottom: 1.8rem;
                border-left: 3px solid #3b82f6;
                display: flex;
                align-items: center;
                gap: 10px;
                font-size: 0.8rem;
                color: #ccdefa;
            }

            .action-btn {
                width: 100%;
                background: linear-gradient(98deg, #2563eb 0%, #1e40af 100%);
                border: none;
                border-radius: 60px;
                padding: 14px 24px;
                color: white;
                font-size: 1rem;
                font-weight: 600;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                cursor: pointer;
                transition: all 0.25s ease;
                font-family: inherit;
                margin-bottom: 1rem;
                box-shadow: 0 8px 18px rgba(0, 0, 0, 0.3);
            }

                .action-btn:hover {
                    background: linear-gradient(98deg, #3b82f6 0%, #1e3a8a 100%);
                    transform: scale(1.01);
                    box-shadow: 0 12px 22px rgba(0, 0, 0, 0.4);
                }

                .action-btn:active {
                    transform: scale(0.98);
                }

                .action-btn:disabled {
                    opacity: 0.7;
                    cursor: not-allowed;
                }

            .secondary-link {
                text-align: center;
                margin-top: 0.75rem;
            }

                .secondary-link a {
                    color: #90b4ff;
                    text-decoration: none;
                    font-size: 0.85rem;
                    font-weight: 500;
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                    cursor: pointer;
                }

                    .secondary-link a:hover {
                        color: #bedaff;
                        text-decoration: underline;
                    }

            .legal-footer {
                text-align: center;
                font-size: 0.7rem;
                color: #8a99b0;
                border-top: 1px solid rgba(255, 255, 255, 0.08);
                padding-top: 1.2rem;
                margin-top: 0.8rem;
            }

            .strength-meter {
                margin-top: -8px;
                margin-bottom: 12px;
                font-size: 0.7rem;
                padding-left: 12px;
                color: #9aa9c2;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .strength-bar {
                flex: 1;
                height: 4px;
                background: #2d3748;
                border-radius: 4px;
                overflow: hidden;
            }

            .strength-fill {
                width: 0%;
                height: 100%;
                background: #ef4444;
                transition: width 0.2s, background 0.2s;
            }

            @@keyframes gentleAppear {
                0% {
                    opacity: 0;
                    transform: translateY(20px);
                }

                100% {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@media (max-width: 550px) {
                .reset-card {
                    padding: 1.5rem;
                    max-width: 92%;
                }

                    .reset-card h1 {
                        font-size: 1.7rem;
                    }

                .brand-logo img {
                    height: 40px;
                }
            }

            .custom-toast {
                font-family: 'Inter', system-ui;
                pointer-events: none;
                animation: fadeUp 0.25s ease-out;
                position: fixed;
                bottom: 24px;
                left: 50%;
                transform: translateX(-50%);
                z-index: 10000;
            }

            @@keyframes fadeUp {
                from {
                    opacity: 0;
                    transform: translateX(-50%) translateY(10px);
                }

                to {
                    opacity: 1;
                    transform: translateX(-50%) translateY(0);
                }
            }

            .material-symbols-outlined {
                font-variation-settings: 'FILL' 0, 'wght' 450, 'GRAD' 0, 'opsz' 24;
            }

            .spinner {
                width: 18px;
                height: 18px;
                border: 2px solid rgba(255, 255, 255, 0.3);
                border-top-color: white;
                border-radius: 50%;
                animation: spin 0.6s linear infinite;
            }

            @@keyframes spin {
                to {
                    transform: rotate(360deg);
                }
            }

            .otp-group {
                display: flex;
                gap: 12px;
                justify-content: center;
                margin-bottom: 1.5rem;
            }

            .otp-digit {
                width: 60px;
                height: 70px;
                text-align: center;
                font-size: 1.8rem;
                font-weight: 600;
                background: rgba(10, 14, 19, 0.8);
                border: 1px solid rgba(255,255,255,0.2);
                border-radius: 20px;
                color: white;
                outline: none;
                font-family: monospace;
            }

                .otp-digit:focus {
                    border-color: #3b82f6;
                    box-shadow: 0 0 0 2px rgba(59,130,246,0.4);
                }

            @@media (max-width: 500px) {
                .otp-digit {
                    width: 48px;
                    height: 58px;
                    font-size: 1.4rem;
                }
            }
    </style>
</head>
<body>
    <video autoplay muted loop id="bg-video">
        <source src="~/assets/bg-1.mp4" type="video/mp4">
    </video>
    <div class="overlay-gradient"></div>

    <div class="reset-card" id="resetCard">
        <div class="header-center">
            @* <div class="brand-logo">
                <img src="https://res.cloudinary.com/dyfpbxcip/image/upload/v1764830496/SCS_logo2_p2ryim.webp"
                    alt="SCS TECH Logo"
                    onerror="this.onerror=null;this.src='https://placehold.co/160x45/1a202c/ffffff?text=SCS+TECH'">
            </div> *@
            <div class="brand-logo">
                <img src="~/assets/Orbus_Logo.png" alt="SCS TECH Logo">
            </div>

            <div class="mcms-badge">RESET PASSWORD</div>
            <h1>Create New Password</h1>
            <div class="subhead" id="emailDisplay">Enter your email to begin</div>
        </div>

        <div id="stepEmailContainer">
            <div class="input-field">
                <span class="material-symbols-outlined">mail</span>
                <input type="email" id="resetEmail" placeholder="Registered email address" autocomplete="email">
            </div>
            <button class="action-btn" id="sendOtpBtn">
                Send Verification Code
                <span class="material-symbols-outlined">send</span>
            </button>
        </div>

        <div id="stepOtpContainer" style="display: none;">
            <div class="info-message" id="otpInfoMessage">
                <span class="material-symbols-outlined">mark_email_unread</span>
                <span>We've sent a 6-digit code to <strong id="otpEmailDisplay"></strong></span>
            </div>
            <div class="otp-group" id="otpContainer">
                <input type="text" maxlength="1" class="otp-digit" data-index="0" autofocus>
                <input type="text" maxlength="1" class="otp-digit" data-index="1">
                <input type="text" maxlength="1" class="otp-digit" data-index="2">
                <input type="text" maxlength="1" class="otp-digit" data-index="3">
                <input type="text" maxlength="1" class="otp-digit" data-index="4">
                <input type="text" maxlength="1" class="otp-digit" data-index="5">
            </div>
            <div class="info-message" style="background: rgba(59,130,246,0.1);">
                <span class="material-symbols-outlined">schedule</span>
                <span>OTP expires in <strong id="timerDisplay">10:00</strong></span>
            </div>
            <button class="action-btn" id="verifyOtpBtn">
                Verify OTP
                <span class="material-symbols-outlined">verified</span>
            </button>
            <div class="secondary-link">
                <a href="#" id="resendOtpLink">Resend OTP</a>
            </div>
        </div>

        <div id="stepPasswordContainer" style="display: none;">
            <div class="input-field">
                <span class="material-symbols-outlined">lock</span>
                <input type="password" id="newPassword" placeholder="New password" autocomplete="new-password">
            </div>
            <div class="strength-meter">
                <span>Password strength</span>
                <div class="strength-bar"><div class="strength-fill" id="strengthFill"></div></div>
                <span id="strengthText" style="min-width: 70px;">Very weak</span>
            </div>
            <div class="input-field">
                <span class="material-symbols-outlined">lock</span>
                <input type="password" id="confirmPassword" placeholder="Confirm new password" autocomplete="off">
            </div>
            <button class="action-btn" id="resetPasswordBtn">
                Reset Password
                <span class="material-symbols-outlined">key</span>
            </button>
        </div>

        <div class="secondary-link">
            <a href="#" id="backToLoginLink">
                <span class="material-symbols-outlined" style="font-size: 1rem;">arrow_back</span> Back to Sign In
            </a>
        </div>

        <div class="legal-footer">
            <a href="#">Privacy Policy</a> • <a href="#">Security</a>
        </div>
    </div>

    <script>
            let timerInterval = null;
            let timeLeft = 600;
            let currentEmail = '';
            let currentOtp = '';

            function showToast(title, message, isSuccess = false) {
                const existing = document.querySelector('.custom-toast');
                if (existing) existing.remove();

                const toastDiv = document.createElement('div');
                toastDiv.className = 'custom-toast';
                const accentColor = isSuccess ? '#10b981' : '#f97316';
                const icon = isSuccess ? 'check_circle' : 'error';
                toastDiv.innerHTML = `
                    <div style="background: #1e1f2c; backdrop-filter: blur(16px); border-left: 4px solid ${accentColor}; border-radius: 20px; padding: 14px 22px; max-width: 360px; box-shadow: 0 20px 35px rgba(0,0,0,0.6);">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <span class="material-symbols-outlined" style="color: ${accentColor};">${icon}</span>
                            <div><strong style="color: ${isSuccess ? '#b0f0c4' : '#ffdd99'};">${escapeHtml(title)}</strong><br><span style="font-size:0.8rem; color:#cddcf5;">${escapeHtml(message)}</span></div>
                        </div>
                    </div>
                `;
                document.body.appendChild(toastDiv);
                setTimeout(() => toastDiv.remove(), 3200);
            }

            function escapeHtml(str) {
                if (!str) return '';
                return str.replace(/[&<>]/g, function(m) {
                    if (m === '&') return '&amp;';
                    if (m === '<') return '&lt;';
                    if (m === '>') return '&gt;';
                    return m;
                });
            }

            function getPasswordStrength(password) {
                if (!password) return { score: 0, text: 'Very weak', color: '#ef4444' };
                let score = 0;
                if (password.length >= 6) score++;
                if (password.length >= 10) score++;
                if (/[A-Z]/.test(password)) score++;
                if (/[0-9]/.test(password)) score++;
                if (/[^A-Za-z0-9]/.test(password)) score++;
                if (score <= 1) return { score: 20, text: 'Very weak', color: '#ef4444' };
                if (score === 2) return { score: 45, text: 'Weak', color: '#f97316' };
                if (score === 3) return { score: 65, text: 'Moderate', color: '#eab308' };
                if (score === 4) return { score: 85, text: 'Strong', color: '#22c55e' };
                return { score: 100, text: 'Very strong', color: '#10b981' };
            }

            function startTimer() {
                if (timerInterval) clearInterval(timerInterval);
                timeLeft = 600;
                const timerDisplay = document.getElementById('timerDisplay');
                if (timerDisplay) {
                    timerInterval = setInterval(() => {
                        if (timeLeft <= 0) {
                            clearInterval(timerInterval);
                            timerDisplay.innerText = '00:00';
                            showToast('OTP Expired', 'Please request a new code.', false);
                            document.getElementById('verifyOtpBtn').disabled = true;
                        } else {
                            timeLeft--;
                            const minutes = Math.floor(timeLeft / 60);
                            const seconds = timeLeft % 60;
                            timerDisplay.innerText = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
                        }
                    }, 1000);
                }
            }

            // Send OTP
            document.getElementById('sendOtpBtn').addEventListener('click', async () => {
                const email = document.getElementById('resetEmail').value.trim().toLowerCase();
                const emailRegex = /^[^\s@@]+@@([^\s@@]+\.)+[^\s@@]+$/;

                if (!email) {
                    showToast('Email Required', 'Please enter your email address.', false);
                    return;
                }
                if (!emailRegex.test(email)) {
                    showToast('Invalid Email', 'Please enter a valid email address.', false);
                    return;
                }

                const btn = document.getElementById('sendOtpBtn');
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<div class="spinner" style="margin:0 auto;"></div>';
                btn.disabled = true;

                try {
                    const response = await fetch('/forgot-password', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ email: email })
                    });

                    const data = await response.json();

                    if (response.ok && data.success) {
                        currentEmail = email;
                        document.getElementById('otpEmailDisplay').innerText = email;
                        document.getElementById('emailDisplay').innerHTML = `Reset password for <strong>${escapeHtml(email)}</strong>`;
                        showToast('OTP Sent', 'Verification code has been sent to your email.', true);

                        document.getElementById('stepEmailContainer').style.display = 'none';
                        document.getElementById('stepOtpContainer').style.display = 'block';
                        document.getElementById('stepPasswordContainer').style.display = 'none';

                        startTimer();
                        setupOtpInputs();
                    } else if (response.status === 404) {
                        showToast('Email Not Found', 'This email is not registered.', false);
                    } else {
                        showToast('Error', data.message || 'Something went wrong.', false);
                    }
                } catch (error) {
                    showToast('Network Error', 'Unable to connect to server.', false);
                } finally {
                    btn.innerHTML = originalHtml;
                    btn.disabled = false;
                }
            });

            function setupOtpInputs() {
                const inputs = document.querySelectorAll('.otp-digit');
                inputs.forEach((input, idx) => {
                    input.addEventListener('input', (e) => {
                        const val = e.target.value.replace(/[^0-9]/g, '');
                        e.target.value = val;
                        if (val && idx < 5) inputs[idx + 1].focus();
                    });
                    input.addEventListener('keydown', (e) => {
                        if (e.key === 'Backspace' && !e.target.value && idx > 0) {
                            inputs[idx - 1].focus();
                        }
                    });
                });
            }

            function getEnteredOtp() {
                let otp = '';
                document.querySelectorAll('.otp-digit').forEach(input => {
                    otp += input.value;
                });
                return otp;
            }

            // Verify OTP
            document.getElementById('verifyOtpBtn').addEventListener('click', async () => {
                const otp = getEnteredOtp();

                if (otp.length !== 6) {
                    showToast('Invalid OTP', 'Please enter all 6 digits.', false);
                    return;
                }

                const btn = document.getElementById('verifyOtpBtn');
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<div class="spinner" style="margin:0 auto;"></div>';
                btn.disabled = true;

                try {
                    // Validate OTP with backend
                    const response = await fetch('/forgot-password/validate', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ email: currentEmail, otp: otp })
                    });

                    if (response.ok) {
                        currentOtp = otp;
                        showToast('OTP Verified', 'You can now set a new password.', true);

                        document.getElementById('stepOtpContainer').style.display = 'none';
                        document.getElementById('stepPasswordContainer').style.display = 'block';

                        if (timerInterval) clearInterval(timerInterval);

                        // Setup password strength checker
                        const newPwd = document.getElementById('newPassword');
                        const strengthFill = document.getElementById('strengthFill');
                        const strengthText = document.getElementById('strengthText');

                        newPwd.addEventListener('input', () => {
                            const strength = getPasswordStrength(newPwd.value);
                            strengthFill.style.width = strength.score + '%';
                            strengthFill.style.background = strength.color;
                            strengthText.textContent = strength.text;
                            strengthText.style.color = strength.color;
                        });
                    } else {
                        showToast('Invalid OTP', 'The code you entered is incorrect.', false);
                    }
                } catch (error) {
                    showToast('Error', 'Failed to verify OTP.', false);
                } finally {
                    btn.innerHTML = originalHtml;
                    btn.disabled = false;
                }
            });

            // Resend OTP
            document.getElementById('resendOtpLink').addEventListener('click', async (e) => {
                e.preventDefault();

                const link = document.getElementById('resendOtpLink');
                link.style.pointerEvents = 'none';
                link.style.opacity = '0.5';

                try {
                    const response = await fetch('/forgot-password', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ email: currentEmail })
                    });

                    if (response.ok) {
                        showToast('OTP Resent', 'A new verification code has been sent.', true);
                        startTimer();
                        document.getElementById('verifyOtpBtn').disabled = false;
                        document.querySelectorAll('.otp-digit').forEach(input => input.value = '');
                        document.querySelector('.otp-digit').focus();
                    } else {
                        showToast('Error', 'Failed to resend OTP.', false);
                    }
                } catch (error) {
                    showToast('Network Error', 'Unable to resend OTP.', false);
                } finally {
                    setTimeout(() => {
                        link.style.pointerEvents = 'auto';
                        link.style.opacity = '1';
                    }, 30000);
                }
            });

            // Reset Password
            document.getElementById('resetPasswordBtn').addEventListener('click', async () => {
                const newPassword = document.getElementById('newPassword').value;
                const confirmPassword = document.getElementById('confirmPassword').value;

                if (!newPassword) {
                    showToast('Password Required', 'Please enter a new password.', false);
                    return;
                }
                if (newPassword.length < 6) {
                    showToast('Weak Password', 'Password must be at least 6 characters.', false);
                    return;
                }
                if (newPassword !== confirmPassword) {
                    showToast('Passwords Mismatch', 'The passwords do not match.', false);
                    return;
                }

                const btn = document.getElementById('resetPasswordBtn');
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<div class="spinner" style="margin:0 auto;"></div>';
                btn.disabled = true;

                try {
                    const response = await fetch('/reset-password', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            email: currentEmail,
                            otp: currentOtp,
                            newPassword: newPassword
                        })
                    });

                    const data = await response.json();

                    if (response.ok && data.success) {
                        showToast('Success!', 'Your password has been reset. Redirecting to login...', true);
                        setTimeout(() => {
                            window.location.href = '/';
                        }, 2000);
                    } else {
                        showToast('Error', data.message || 'Failed to reset password.', false);
                    }
                } catch (error) {
                    showToast('Network Error', 'Unable to reset password.', false);
                } finally {
                    btn.innerHTML = originalHtml;
                    btn.disabled = false;
                }
            });

            // Back to login
            document.getElementById('backToLoginLink').addEventListener('click', (e) => {
                e.preventDefault();
                window.location.href = '/';
            });

            // Enter key support
            document.getElementById('resetEmail').addEventListener('keypress', (e) => {
                if (e.key === 'Enter') document.getElementById('sendOtpBtn').click();
            });
    </script>
</body>
</html>