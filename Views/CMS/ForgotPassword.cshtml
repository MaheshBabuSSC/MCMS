@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>MCMS • Password Recovery</title>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                display: flex;
                justify-content: center;
                align-items: center;
                min-height: 100vh;
                font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, 'Roboto', sans-serif;
                background: #0a0c10;
                overflow: hidden;
                position: relative;
            }

            #bg-video {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                z-index: -2;
                filter: brightness(0.45) saturate(1.1);
            }

            .overlay-gradient {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: radial-gradient(circle at center, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.65) 100%);
                z-index: -1;
            }

            .recovery-card {
                width: 100%;
                max-width: 520px;
                background: rgba(18, 22, 28, 0.78);
                backdrop-filter: blur(18px);
                -webkit-backdrop-filter: blur(18px);
                border-radius: 2rem;
                border: 1px solid rgba(255, 255, 255, 0.12);
                box-shadow: 0 30px 50px rgba(0, 0, 0, 0.6), 0 0 0 0.5px rgba(255, 255, 255, 0.05);
                padding: 2rem 2rem 2.2rem;
                transition: transform 0.3s ease, box-shadow 0.3s ease;
                margin: 1.5rem;
                animation: gentleAppear 0.6s ease-out;
            }

                .recovery-card:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 35px 55px rgba(0, 0, 0, 0.7);
                }

            .header-center {
                text-align: center;
                margin-bottom: 2rem;
            }

            .brand-logo {
                display: flex;
                justify-content: center;
                align-items: center;
                margin-bottom: 1.2rem;
            }

                .brand-logo img {
                    height: 48px;
                    width: auto;
                    object-fit: contain;
                    filter: drop-shadow(0 2px 3px rgba(0,0,0,0.3));
                }

            .welcome-section {
                text-align: center;
            }

            .mcms-badge {
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 3px;
                font-weight: 500;
                color: #7c8ba0;
                margin-bottom: 0.5rem;
            }

            .welcome-section h1 {
                font-size: 2rem;
                font-weight: 600;
                background: linear-gradient(135deg, #FFFFFF 0%, #c0d4ff 100%);
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
                letter-spacing: -0.3px;
                margin: 0.25rem 0 0.3rem 0;
            }

            .subhead {
                font-size: 0.9rem;
                color: #b9c3d4;
                margin-top: 6px;
            }

            .form-group {
                margin-bottom: 1.5rem;
            }

            .input-field {
                position: relative;
            }

                .input-field .material-symbols-outlined {
                    position: absolute;
                    left: 15px;
                    top: 50%;
                    transform: translateY(-50%);
                    font-size: 1.35rem;
                    color: #8f9bb3;
                    transition: color 0.2s;
                    pointer-events: none;
                }

                .input-field input {
                    width: 100%;
                    background: rgba(10, 14, 19, 0.7);
                    border: 1px solid rgba(255, 255, 255, 0.15);
                    border-radius: 60px;
                    padding: 14px 20px 14px 48px;
                    font-size: 0.95rem;
                    font-weight: 500;
                    color: #f0f3fa;
                    outline: none;
                    transition: all 0.25s ease;
                    font-family: inherit;
                }

                    .input-field input:focus {
                        border-color: #3b82f6;
                        background: rgba(20, 28, 38, 0.9);
                        box-shadow: 0 0 0 3px rgba(59,130,246,0.25);
                    }

                    .input-field input::placeholder {
                        color: #7e8aa2;
                        font-weight: 400;
                        font-size: 0.9rem;
                    }

            .info-message {
                background: rgba(59,130,246,0.15);
                border-radius: 16px;
                padding: 12px 16px;
                margin-bottom: 1.8rem;
                border-left: 3px solid #3b82f6;
                display: flex;
                align-items: center;
                gap: 10px;
                font-size: 0.8rem;
                color: #ccdefa;
            }

                .info-message span {
                    font-size: 1.2rem;
                }

            .action-btn {
                width: 100%;
                background: linear-gradient(98deg, #2563eb 0%, #1e40af 100%);
                border: none;
                border-radius: 60px;
                padding: 14px 24px;
                color: white;
                font-size: 1rem;
                font-weight: 600;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                cursor: pointer;
                transition: all 0.25s ease;
                font-family: inherit;
                margin-bottom: 1rem;
                box-shadow: 0 8px 18px rgba(0, 0, 0, 0.3);
            }

                .action-btn:hover {
                    background: linear-gradient(98deg, #3b82f6 0%, #1e3a8a 100%);
                    transform: scale(1.01);
                    box-shadow: 0 12px 22px rgba(0, 0, 0, 0.4);
                }

                .action-btn:active {
                    transform: scale(0.98);
                }

                .action-btn:disabled {
                    opacity: 0.7;
                    cursor: not-allowed;
                    transform: none;
                }

            .secondary-link {
                text-align: center;
                margin-top: 0.75rem;
            }

                .secondary-link a {
                    color: #90b4ff;
                    text-decoration: none;
                    font-size: 0.85rem;
                    font-weight: 500;
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                    transition: 0.2s;
                    cursor: pointer;
                }

                    .secondary-link a:hover {
                        color: #bedaff;
                        text-decoration: underline;
                    }

            .legal-footer {
                text-align: center;
                font-size: 0.7rem;
                color: #8a99b0;
                border-top: 1px solid rgba(255, 255, 255, 0.08);
                padding-top: 1.2rem;
                margin-top: 0.4rem;
            }

                .legal-footer a {
                    color: #9bb5ff;
                    text-decoration: none;
                }

                    .legal-footer a:hover {
                        text-decoration: underline;
                    }

            @@keyframes gentleAppear {
                0% {
                    opacity: 0;
                    transform: translateY(20px);
                }

                100% {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@media (max-width: 550px) {
                .recovery-card {
                    padding: 1.8rem 1.5rem;
                    max-width: 92%;
                }

                .welcome-section h1 {
                    font-size: 1.8rem;
                }

                .brand-logo img {
                    height: 40px;
                }
            }

            .custom-toast-alert {
                font-family: 'Segoe UI', system-ui, 'Inter', sans-serif;
                pointer-events: none;
                animation: fadeUp 0.25s ease-out;
            }

            @@keyframes fadeUp {
                from {
                    opacity: 0;
                    transform: translateX(-50%) translateY(10px);
                }

                to {
                    opacity: 1;
                    transform: translateX(-50%) translateY(0);
                }
            }

            .material-symbols-outlined {
                font-variation-settings: 'FILL' 0, 'wght' 450, 'GRAD' 0, 'opsz' 24;
            }

            .spinner {
                width: 18px;
                height: 18px;
                border: 2px solid rgba(255, 255, 255, 0.3);
                border-top-color: white;
                border-radius: 50%;
                animation: spin 0.6s linear infinite;
            }

            @@keyframes spin {
                to {
                    transform: rotate(360deg);
                }
            }
    </style>
</head>
<body>
    <video autoplay muted loop id="bg-video">
        <source src="~/assets/bg-1.mp4" type="video/mp4">
    </video>
    <div class="overlay-gradient"></div>

    <div class="recovery-card">
        <div class="header-center">
            @* <div class="brand-logo">
                <img src="https://res.cloudinary.com/dyfpbxcip/image/upload/v1764830496/SCS_logo2_p2ryim.webp"
                    alt="SCS TECH Logo"
                    onerror="this.onerror=null;this.src='https://placehold.co/160x45/1a202c/ffffff?text=SCS+TECH'">
            </div> *@

            <div class="brand-logo">
                <img src="~/assets/Orbus_Logo.png" alt="SCS TECH Logo">
            </div>

            <div class="welcome-section">
                <div class="mcms-badge">PASSWORD RECOVERY</div>
                <h1>Forgot Password?</h1>
                <div class="subhead">Enter your registered email to receive a reset OTP</div>
            </div>
        </div>

        <div id="step1Container">
            <div class="form-group">
                <div class="input-field">
                    <span class="material-symbols-outlined">mail</span>
                    <input type="email" id="resetEmail" placeholder="Work email address" autocomplete="email">
                </div>
            </div>

            <div class="info-message">
                <span class="material-symbols-outlined">info</span>
                <span>We'll send a 6-digit OTP to your email for verification.</span>
            </div>

            <button class="action-btn" id="sendOtpBtn">
                Send Reset OTP
                <span class="material-symbols-outlined" style="font-size: 1.2rem;">mail_lock</span>
            </button>
        </div>

        <div id="step2Container" style="display: none;">
            <div class="info-message" id="otpInfoMessage" style="background: rgba(16,185,129,0.12); border-left-color: #10b981;">
                <span class="material-symbols-outlined">mark_email_unread</span>
                <span>OTP sent to <strong id="emailDisplay"></strong>. Please check your email.</span>
            </div>
            <div class="form-group">
                <div class="input-field">
                    <span class="material-symbols-outlined">pin</span>
                    <input type="text" id="otpCode" placeholder="Enter 6-digit OTP" maxlength="6" autocomplete="off">
                </div>
            </div>
            <div class="info-message" style="background: rgba(59,130,246,0.1); border-left-color: #3b82f6;">
                <span class="material-symbols-outlined">schedule</span>
                <span>OTP expires in <strong id="timerDisplay">10:00</strong></span>
            </div>
            <button class="action-btn" id="verifyOtpBtn">
                Verify OTP
                <span class="material-symbols-outlined">verified</span>
            </button>
            <div class="secondary-link">
                <a href="#" id="resendOtpLink">Resend OTP</a>
            </div>
        </div>

        <div id="step3Container" style="display: none;">
            <div class="form-group">
                <div class="input-field">
                    <span class="material-symbols-outlined">lock</span>
                    <input type="password" id="newPassword" placeholder="New password" autocomplete="new-password">
                </div>
            </div>
            <div class="form-group">
                <div class="input-field">
                    <span class="material-symbols-outlined">lock</span>
                    <input type="password" id="confirmPassword" placeholder="Confirm new password" autocomplete="off">
                </div>
            </div>
            <button class="action-btn" id="resetPasswordBtn">
                Reset Password
                <span class="material-symbols-outlined">key</span>
            </button>
        </div>

        <div class="secondary-link">
            <a href="#" id="backToLoginLink">
                <span class="material-symbols-outlined" style="font-size: 1rem;">arrow_back</span> Back to Sign In
            </a>
        </div>

        <div class="legal-footer">
            <a href="#">Privacy Policy</a> • <a href="#">Support Center</a>
        </div>
    </div>

    <script>
            let timerInterval = null;
            let timeLeft = 600; // 10 minutes in seconds
            let currentEmail = '';

            function showToast(title, message, isSuccess = false) {
                const existingAlert = document.querySelector('.custom-toast-alert');
                if (existingAlert) existingAlert.remove();

                const alertDiv = document.createElement('div');
                alertDiv.className = 'custom-toast-alert';
                const accentColor = isSuccess ? '#10b981' : '#f97316';
                const icon = isSuccess ? 'check_circle' : 'error';
                const titleColor = isSuccess ? '#a3e9c4' : '#ffd966';
                alertDiv.innerHTML = `
                    <div style="background: #1e1f2c; backdrop-filter: blur(12px); border-left: 4px solid ${accentColor}; border-radius: 18px; padding: 14px 20px; max-width: 340px; box-shadow: 0 15px 30px rgba(0,0,0,0.5);">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <span class="material-symbols-outlined" style="color: ${accentColor};">${icon}</span>
                            <div><strong style="color:${titleColor};">${escapeHtml(title)}</strong><br><span style="font-size:0.85rem; color:#d1dbe8;">${escapeHtml(message)}</span></div>
                        </div>
                    </div>
                `;
                alertDiv.style.position = 'fixed';
                alertDiv.style.bottom = '24px';
                alertDiv.style.left = '50%';
                alertDiv.style.transform = 'translateX(-50%)';
                alertDiv.style.zIndex = '9999';
                document.body.appendChild(alertDiv);

                setTimeout(() => {
                    if (alertDiv) alertDiv.remove();
                }, 3500);
            }

            function escapeHtml(str) {
                if (!str) return '';
                return str.replace(/[&<>]/g, function(m) {
                    if (m === '&') return '&amp;';
                    if (m === '<') return '&lt;';
                    if (m === '>') return '&gt;';
                    return m;
                });
            }

            function startTimer() {
                if (timerInterval) clearInterval(timerInterval);
                timeLeft = 600;
                const timerDisplay = document.getElementById('timerDisplay');
                if (timerDisplay) {
                    timerInterval = setInterval(() => {
                        if (timeLeft <= 0) {
                            clearInterval(timerInterval);
                            timerDisplay.innerText = '00:00';
                            showToast('OTP Expired', 'Please request a new OTP.', false);
                            document.getElementById('verifyOtpBtn').disabled = true;
                        } else {
                            timeLeft--;
                            const minutes = Math.floor(timeLeft / 60);
                            const seconds = timeLeft % 60;
                            timerDisplay.innerText = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
                        }
                    }, 1000);
                }
            }

            function resetTimer() {
                if (timerInterval) clearInterval(timerInterval);
                startTimer();
            }

            // Step 1: Send OTP
            document.getElementById('sendOtpBtn').addEventListener('click', async () => {
                const email = document.getElementById('resetEmail').value.trim().toLowerCase();

                if (!email) {
                    showToast('Email Required', 'Please enter your email address.', false);
                    return;
                }

                const emailRegex = /^[^\s@@]+@@([^\s@@]+\.)+[^\s@@]+$/;
                if (!emailRegex.test(email)) {
                    showToast('Invalid Email', 'Please enter a valid email address.', false);
                    return;
                }

                const sendBtn = document.getElementById('sendOtpBtn');
                const originalHtml = sendBtn.innerHTML;
                sendBtn.innerHTML = '<div class="spinner" style="margin:0 auto;"></div>';
                sendBtn.disabled = true;

                try {
                    const response = await fetch('/forgot-password', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ email: email })
                    });

                    const data = await response.json();

                    if (response.ok && data.success) {
                        currentEmail = email;
                        document.getElementById('emailDisplay').innerText = email;
                        showToast('OTP Sent', 'A verification code has been sent to your email.', true);

                        // Switch to step 2
                        document.getElementById('step1Container').style.display = 'none';
                        document.getElementById('step2Container').style.display = 'block';
                        document.getElementById('step3Container').style.display = 'none';

                        startTimer();
                        document.getElementById('otpCode').value = '';
                        document.getElementById('verifyOtpBtn').disabled = false;
                    } else if (response.status === 404) {
                        showToast('Email Not Found', 'This email is not registered in our system.', false);
                    } else {
                        showToast('Error', data.message || 'Something went wrong. Please try again.', false);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    showToast('Network Error', 'Unable to connect to the server. Please try again.', false);
                } finally {
                    sendBtn.innerHTML = originalHtml;
                    sendBtn.disabled = false;
                }
            });

            // Resend OTP
            document.getElementById('resendOtpLink').addEventListener('click', async (e) => {
                e.preventDefault();

                if (!currentEmail) {
                    showToast('Session Expired', 'Please start over.', false);
                    window.location.reload();
                    return;
                }

                const resendLink = document.getElementById('resendOtpLink');
                resendLink.style.pointerEvents = 'none';
                resendLink.style.opacity = '0.5';

                try {
                    const response = await fetch('/forgot-password', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ email: currentEmail })
                    });

                    const data = await response.json();

                    if (response.ok && data.success) {
                        showToast('OTP Resent', 'A new verification code has been sent.', true);
                        resetTimer();
                        document.getElementById('verifyOtpBtn').disabled = false;
                    } else {
                        showToast('Error', 'Failed to resend OTP. Please try again.', false);
                    }
                } catch (error) {
                    showToast('Network Error', 'Unable to resend OTP.', false);
                } finally {
                    setTimeout(() => {
                        resendLink.style.pointerEvents = 'auto';
                        resendLink.style.opacity = '1';
                    }, 30000);
                }
            });

            // Verify OTP
            document.getElementById('verifyOtpBtn').addEventListener('click', async () => {
                const otp = document.getElementById('otpCode').value.trim();

                if (!otp || otp.length !== 6) {
                    showToast('Invalid OTP', 'Please enter a valid 6-digit OTP.', false);
                    return;
                }

                const verifyBtn = document.getElementById('verifyOtpBtn');
                const originalHtml = verifyBtn.innerHTML;
                verifyBtn.innerHTML = '<div class="spinner" style="margin:0 auto;"></div>';
                verifyBtn.disabled = true;

                try {
                    // Store OTP in session for reset
                    sessionStorage.setItem('resetEmail', currentEmail);
                    sessionStorage.setItem('resetOtp', otp);

                    // Proceed to password reset step
                    document.getElementById('step2Container').style.display = 'none';
                    document.getElementById('step3Container').style.display = 'block';

                    if (timerInterval) clearInterval(timerInterval);

                } catch (error) {
                    console.error('Error:', error);
                    showToast('Error', 'Something went wrong.', false);
                    verifyBtn.disabled = false;
                } finally {
                    verifyBtn.innerHTML = originalHtml;
                }
            });

            // Reset Password
            document.getElementById('resetPasswordBtn').addEventListener('click', async () => {
                const newPassword = document.getElementById('newPassword').value;
                const confirmPassword = document.getElementById('confirmPassword').value;

                if (!newPassword) {
                    showToast('Password Required', 'Please enter a new password.', false);
                    return;
                }

                if (newPassword.length < 6) {
                    showToast('Weak Password', 'Password must be at least 6 characters long.', false);
                    return;
                }

                if (newPassword !== confirmPassword) {
                    showToast('Passwords Mismatch', 'The passwords do not match.', false);
                    return;
                }

                const resetBtn = document.getElementById('resetPasswordBtn');
                const originalHtml = resetBtn.innerHTML;
                resetBtn.innerHTML = '<div class="spinner" style="margin:0 auto;"></div>';
                resetBtn.disabled = true;

                try {
                    const response = await fetch('/reset-password', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            email: sessionStorage.getItem('resetEmail'),
                            otp: sessionStorage.getItem('resetOtp'),
                            newPassword: newPassword
                        })
                    });

                    const data = await response.json();

                    if (response.ok && data.success) {
                        showToast('Success!', 'Your password has been reset. Redirecting to login...', true);

                        // Clear session data
                        sessionStorage.removeItem('resetEmail');
                        sessionStorage.removeItem('resetOtp');

                        setTimeout(() => {
                            window.location.href = '/';
                        }, 2000);
                    } else {
                        showToast('Error', data.message || 'Failed to reset password. Please try again.', false);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    showToast('Network Error', 'Unable to reset password.', false);
                } finally {
                    resetBtn.innerHTML = originalHtml;
                    resetBtn.disabled = false;
                }
            });

            // Back to login
            document.getElementById('backToLoginLink').addEventListener('click', (e) => {
                e.preventDefault();
                window.location.href = '/';
            });

            // Enter key support
            document.getElementById('resetEmail').addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    document.getElementById('sendOtpBtn').click();
                }
            });

            document.getElementById('otpCode').addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    document.getElementById('verifyOtpBtn').click();
                }
            });

            document.getElementById('newPassword').addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    document.getElementById('resetPasswordBtn').click();
                }
            });

            document.getElementById('confirmPassword').addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    document.getElementById('resetPasswordBtn').click();
                }
            });
    </script>
</body>
</html>