@model List<CMS.Models.UsersList>
@{
    ViewData["Title"] = "User Management";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EAM — User Management</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root {
            --bg-deep: #060913;
            --bg-panel: rgba(13, 20, 33, 0.85);
            --bg-card: #0d1527;
            --bg-hover: #15223c;
            --border: rgba(30, 45, 69, 0.7);
            --border-lit: #00c8ff;
            --accent: #00c8ff;
            --accent-dim: #0096c0;
            --amber: #f5a623;
            --emerald: #00e09e;
            --crimson: #ff4757;
            --violet: #9b59ff;
            --text-1: #e8eef5;
            --text-2: #8a9db8;
            --text-3: #4a6080;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg-deep);
            color: var(--text-1);
            min-height: 100vh;
            overflow-x: hidden;
        }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background: radial-gradient(ellipse 50% 35% at 80% 10%, rgba(0,200,255,0.08) 0%, transparent 60%), radial-gradient(ellipse 40% 50% at 10% 80%, rgba(155,89,255,0.05) 0%, transparent 60%);
            pointer-events: none;
            z-index: 0;
        }


        /* Animations */
        @@keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: .4; }
        }

        /* Main */
        .main {
            padding: 0px 28px;
            position: relative;
            z-index: 1;
        }

            #bgVideo {
                /* position: fixed;
                inset: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                z-index: -2;
                /* MAIN CHANGE */
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                z-index: -2;
                filter: brightness(0.8) blur(6px);
                transform: scale(1.02); 
            }

            .overlay-dark {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: radial-gradient(circle at 20% 30%, rgba(0, 0, 0, 0.65), rgba(8, 10, 18, 0.85));
                backdrop-filter: blur(6px);
                z-index: -1;
            }

            body::after {
                content: "";
                position: fixed;
                inset: 0;
                /* LIGHTER OVERLAY */
                background: rgba(0, 0, 0, 0.35);
                z-index: -1;
                pointer-events: none;
            }

            
            .stat-card,
            .search-box,
            .chip {
                background: rgba(13, 21, 39, 0.65) !important;
                backdrop-filter: blur(14px);
            }

            .pagination {
                display: grid;
                grid-template-columns: 1fr auto 1fr;
                align-items: center;
                gap: 12px;
            }

            .entries-control {
                display: flex;
                align-items: center;
                gap: 8px;
                color: var(--text-3);
                font-size: 12px;
            }

                .entries-control select {
                    background: var(--bg-card);
                    color: var(--text-1);
                    border: 1px solid var(--border);
                    border-radius: 6px;
                    padding: 5px 8px;
                }

            .pagination-info {
                text-align: center;
            }

            .pagination-controls {
                justify-content: flex-end;
            }

        /* Topbar */
        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 28px;
            animation: fadeIn 0.8s ease-out 0.2s both;
            margin-top:20px;
        }

        .page-title {
            font-size: 24px;
            font-weight: 700;
            letter-spacing: -0.3px;
        }

        .page-sub {
            font-size: 12px;
            color: var(--text-3);
            margin-top: 2px;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .search-box {
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 8px 14px;
            font-size: 12px;
            color: var(--text-2);
            transition: all 0.3s;
            backdrop-filter: blur(12px);
        }

        .search-box input {
            background: none;
            border: none;
            outline: none;
            color: var(--text-1);
            font-size: 12px;
            font-family: inherit;
            width: 200px;
        }

        .search-box input::placeholder {
            color: var(--text-3);
        }

        .search-box:focus-within {
            border-color: var(--border-lit);
            background: var(--bg-hover);
        }

        /* Stats Strip */
            .stats-strip {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 1.5rem;
                margin-bottom: 2.5rem;
                margin-top: 25px;
            }

            .stat-card {
                background: rgba(18, 20, 30, 0.65) !important;
                backdrop-filter: blur(12px);
                border-radius: 28px;
                border: 1px solid rgba(255, 255, 255, 0.08);
                padding: 1.4rem 1.5rem;
                transition: all 0.25s ease;
                box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.3);
                display: flex;
                align-items: center;
                gap: 18px;
                min-height: 120px;
            }

                .stat-card:hover {
                    transform: translateY(-4px);
                    background: rgba(28, 32, 48, 0.8) !important;
                    border-color: rgba(59, 130, 246, 0.4);
                }

            .stat-icon {
                min-width: 64px;
                width: 64px;
                height: 64px;
                border-radius: 22px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 24px;
                flex-shrink: 0;
            }

                .stat-icon.blue {
                    background: rgba(0, 200, 255, 0.12);
                    color: #00c8ff;
                }

                .stat-icon.green {
                    background: rgba(0, 224, 158, 0.12);
                    color: #00e09e;
                }

                .stat-icon.amber {
                    background: rgba(245, 166, 35, 0.12);
                    color: #f5a623;
                }

                .stat-icon.red {
                    background: rgba(255, 71, 87, 0.12);
                    color: #ff4757;
                }

            .stat-info {
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .stat-label {
                font-size: 0.78rem;
                text-transform: uppercase;
                letter-spacing: 1px;
                color: #9ca3af;
                margin-bottom: 6px;
                font-weight: 600;
            }

            .stat-value {
                font-size: 2rem;
                font-weight: 700;
                letter-spacing: -0.5px;
                line-height: 1;
            }

                .stat-value.blue {
                    color: #00c8ff;
                }

                .stat-value.green {
                    color: #00e09e;
                }

                .stat-value.amber {
                    color: #f5a623;
                }

                .stat-value.red {
                    color: #ff4757;
                }

            @@media (max-width: 768px) {
                .stats-strip {
                    grid-template-columns: 1fr;
                }
            }

        /* Toolbar */
        .toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
            animation: fadeInUp 0.6s ease-out 0.4s both;
        }

        .filter-group {
            display: flex;
            gap: 8px;
        }

        .chip {
            padding: 6px 14px;
            border-radius: 8px;
            font-size: 11px;
            cursor: pointer;
            border: 1px solid var(--border);
            color: var(--text-2);
            transition: all 0.25s ease;
            font-weight: 600;
            background: var(--bg-card);
        }

        .chip.active {
            border-color: var(--accent);
            color: var(--accent);
            background: rgba(0,200,255,0.08);
        }

        .chip:hover:not(.active) {
            background: var(--bg-hover);
            color: var(--text-1);
        }

        .action-group {
            display: flex;
            gap: 10px;
        }

        .btn {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 8px 16px;
            border-radius: 9px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            border: 1px solid transparent;
            transition: all 0.25s ease;
            font-family: inherit;
        }

        .btn-primary {
            background: var(--accent);
            color: var(--bg-deep);
            border-color: var(--accent);
        }

        .btn-primary:hover {
            background: #00e0ff;
            box-shadow: 0 0 20px rgba(0,200,255,0.35);
            transform: translateY(-1px);
        }

        .btn-ghost {
            background: var(--bg-card);
            color: var(--text-2);
            border-color: var(--border);
        }

        .btn-ghost:hover {
            background: var(--bg-hover);
            color: var(--text-1);
        }

        /* Panel */
        .panel {
            background: rgba(18, 20, 30, 0.65) !important;
            border: 1px solid var(--border);
            border-radius: 14px;
            overflow: hidden;
            backdrop-filter: blur(12px);
            animation: fadeInUp 0.7s ease-out 0.5s both;
        }

        .panel-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 20px;
            border-bottom: 1px solid var(--border);
        }

        .panel-title {
            font-size: 14px;
            font-weight: 700;
        }

        .panel-meta {
            font-size: 11px;
            color: var(--text-3);
            font-weight: 500;
        }

        /* Table */
        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        .data-table th {
            text-align: left;
            padding: 11px 20px;
            font-size: 10px;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            color: var(--text-3);
            font-weight: 700;
            background: rgba(255,255,255,0.015);
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }

        .data-table td {
            padding: 14px 20px;
            border-bottom: 1px solid rgba(30,45,69,0.4);
            color: var(--text-2);
            vertical-align: middle;
        }

        .data-table tbody tr {
            cursor: pointer;
            transition: background 0.2s ease;
        }

        .data-table tbody tr:hover td {
            background: rgba(0,200,255,0.025);
            color: var(--text-1);
        }

        /* User Cell */
        .user-cell {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-av {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 800;
            flex-shrink: 0;
            border: 1px solid rgba(255,255,255,0.06);
        }

        .user-av.av-1 { background: linear-gradient(135deg, #00c8ff, #0060a0); }
        .user-av.av-2 { background: linear-gradient(135deg, #f5a623, #c06000); }
        .user-av.av-3 { background: linear-gradient(135deg, #9b59ff, #5500cc); }
        .user-av.av-4 { background: linear-gradient(135deg, #00e09e, #008060); }
        .user-av.av-5 { background: linear-gradient(135deg, #ff4757, #aa1020); }
        .user-av.av-6 { background: linear-gradient(135deg, #f5a623, #9b59ff); }
        .user-av.av-7 { background: linear-gradient(135deg, #00c8ff, #00e09e); }
        .user-av.av-8 { background: linear-gradient(135deg, #ff4757, #9b59ff); }

        .user-info { min-width: 0; }
        .user-name { font-size: 13px; font-weight: 600; color: var(--text-1); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .user-email { font-size: 11px; color: var(--text-3); margin-top: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

        /* Badges */
        .role-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 9px;
            border-radius: 6px;
            font-size: 10px;
            font-weight: 700;
            white-space: nowrap;
        }

        .role-badge::before {
            content: '';
            width: 5px;
            height: 5px;
            border-radius: 50%;
        }

        .role-admin { background: rgba(0,200,255,0.1); color: var(--accent); border: 1px solid rgba(0,200,255,0.2); }
        .role-admin::before { background: var(--accent); }
        .role-engineer { background: rgba(155,89,255,0.1); color: var(--violet); border: 1px solid rgba(155,89,255,0.2); }
        .role-engineer::before { background: var(--violet); }
        .role-operator { background: rgba(245,166,35,0.1); color: var(--amber); border: 1px solid rgba(245,166,35,0.2); }
        .role-operator::before { background: var(--amber); }
        .role-viewer { background: rgba(138,157,184,0.1); color: var(--text-2); border: 1px solid rgba(138,157,184,0.15); }
        .role-viewer::before { background: var(--text-2); }

        .status-pill {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 5px;
            font-size: 10px;
            font-weight: 700;
            white-space: nowrap;
        }

        .s-active { background: rgba(0,224,158,0.12); color: var(--emerald); }
        .s-inactive { background: rgba(138,157,184,0.1); color: var(--text-3); }

        .zone-tag {
            font-size: 11px;
            color: var(--text-2);
            font-weight: 500;
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border);
            padding: 3px 8px;
            border-radius: 5px;
            white-space: nowrap;
        }

        /* Row Actions */
        .row-actions {
            display: flex;
            gap: 6px;
            opacity: 0;
            transition: opacity 0.2s ease;
        }

        .data-table tbody tr:hover .row-actions {
            opacity: 1;
        }

        .action-btn {
            width: 28px;
            height: 28px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--bg-hover);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 12px;
            transition: all 0.2s ease;
            color: var(--text-2);
            text-decoration: none;
        }

        .action-btn:hover {
            border-color: var(--accent);
            color: var(--accent);
            background: rgba(0,200,255,0.08);
        }

        .action-btn.danger:hover {
            border-color: var(--crimson);
            color: var(--crimson);
            background: rgba(255,71,87,0.08);
        }

        /* Pagination */
        .pagination {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 20px;
            border-top: 1px solid var(--border);
        }

        .pagination-info {
            font-size: 12px;
            color: var(--text-3);
            font-weight: 500;
        }

        .pagination-controls {
            display: flex;
            gap: 6px;
        }

        .page-btn {
            min-width: 32px;
            height: 32px;
            border-radius: 7px;
            border: 1px solid var(--border);
            background: var(--bg-card);
            color: var(--text-2);
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            padding: 0 6px;
            font-family: inherit;
        }

        .page-btn:hover {
            border-color: var(--accent);
            color: var(--accent);
            background: rgba(0,200,255,0.08);
        }

        .page-btn.active {
            border-color: var(--accent);
            color: var(--accent);
            background: rgba(0,200,255,0.12);
        }

        /* Alert messages */
        .alert-success {
            background: rgba(0,224,158,0.1);
            border: 1px solid var(--emerald);
            color: var(--emerald);
            padding: 12px 16px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-size: 13px;
        }

        .alert-error {
            background: rgba(255,71,87,0.1);
            border: 1px solid var(--crimson);
            color: var(--crimson);
            padding: 12px 16px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-size: 13px;
        }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--text-3); border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--border-lit); }
    </style>
</head>
<body>
    <main class="main">

        <video autoplay muted loop playsinline id="bgVideo">
            <source src="~/assets/bg-1.mp4" type="video/mp4">
        </video>
        <div class="overlay-dark"></div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert-success">
                <i class="fa-solid fa-check-circle"></i> @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert-error">
                <i class="fa-solid fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            </div>
        }

        <!-- Topbar -->
        <div class="topbar">
            <div>
                <h1 class="page-title">User Management</h1>
                <p class="page-sub">Manage system users, roles and access permissions</p>
            </div>
            <div class="topbar-right">
                <div class="search-box">
                    <i class="fa-solid fa-search"></i>
                    <input type="text" id="searchInput" placeholder="Search users..." onkeyup="filterUsers()">
                </div>
            </div>
        </div>

        <!-- Stats Strip -->
        @{
            var totalUsers = Model?.Count ?? 0;
            var activeUsers = Model?.Count(u => u.IsActive) ?? 0;
            var inactiveUsers = totalUsers - activeUsers;
            var adminUsers = Model?.Count(u => u.RoleName?.ToLower() == "admin") ?? 0;
        }

        <div class="stats-strip">
            <div class="stat-card">
                <div class="stat-icon blue"><i class="fa-solid fa-users"></i></div>
                <div class="stat-info">
                    <div class="stat-label">Total Users</div>
                    <div class="stat-value blue">@totalUsers</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon green"><i class="fa-solid fa-circle-check"></i></div>
                <div class="stat-info">
                    <div class="stat-label">Active</div>
                    <div class="stat-value green">@activeUsers</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon amber"><i class="fa-solid fa-lock"></i></div>
                <div class="stat-info">
                    <div class="stat-label">Inactive</div>
                    <div class="stat-value amber">@inactiveUsers</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon red"><i class="fa-solid fa-user-gear"></i></div>
                <div class="stat-info">
                    <div class="stat-label">Admins</div>
                    <div class="stat-value red">@adminUsers</div>
                </div>
            </div>
        </div>

        <!-- Toolbar -->
        <div class="toolbar">
            <div class="filter-group">
                <div class="chip active" onclick="setFilter(this, 'all')">All Users</div>
<div class="chip" onclick="setFilter(this, 'system administrator')">System Administrator</div>
<div class="chip" onclick="setFilter(this, 'operations manager')">Operations Manager</div>
<div class="chip" onclick="setFilter(this, 'field engineer')">Field Engineer</div>
<div class="chip" onclick="setFilter(this, 'auditor')">Auditor</div>
            </div>
            <div class="action-group">
                @* <button class="btn btn-ghost" onclick="exportUsers()">
                    <i class="fa-solid fa-download"></i> Export
                </button> *@
                <a href="/Admin/UserCreation" class="btn btn-primary">
                    <i class="fa-solid fa-plus"></i> Add User
                </a>
            </div>
        </div>

        <!-- Table Panel -->
        <div class="panel">
            <div class="panel-head">
                <div class="panel-title">System Users</div>
                <div class="panel-meta" id="rowCount">Showing @totalUsers of @totalUsers users</div>
            </div>

            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width:260px">User</th>
                        <th>Employee ID</th>
                        <th>Role</th>
                        <th>Site / Location</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        @* <th style="width:100px">Actions</th> *@
                    </tr>
                </thead>
                <tbody id="userTableBody">
                    @if (Model != null && Model.Any())
                    {
                        var avatarIndex = 1;
                        foreach (var user in Model)
                        {
                            var avatarClass = $"av-{((avatarIndex % 8) + 1)}";
                            var initials = GetInitials(user.FullName);
                            var roleClass = GetRoleClass(user.RoleName);
                            var statusClass = user.IsActive ? "s-active" : "s-inactive";
                            var statusText = user.IsActive ? "Active" : "Inactive";
                            
                            <tr data-role="@(user.RoleName?.ToLower())">
                                <td>
                                    <div class="user-cell">
                                        <div class="user-av @avatarClass">@initials</div>
                                        <div class="user-info">
                                            <div class="user-name">@user.FullName</div>
                                            <div class="user-email">@user.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td style="font-weight:600;color:var(--text-1);">@(string.IsNullOrEmpty(user.EmployeeId) ? "N/A" : user.EmployeeId)</td>
                                <td><span class="role-badge @roleClass">@(user.RoleName?.ToUpper() ?? "USER")</span></td>
                                <td><span class="zone-tag">@(string.IsNullOrEmpty(user.Site) ? "Not Assigned" : user.Site)</span></td>
                                <td><span class="status-pill @statusClass">@statusText</span></td>
<td>
  <span class="last-login">
    @user.CreatedDate.ToString("dd-MM-yyyy  HH:mm")
  </span>
</td>                   
@* <td>
                                    <div class="row-actions">
                                        <a href="/Admin/EditUser/@user.UserId" class="action-btn" title="Edit">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        <a href="#" class="action-btn" title="View" onclick="viewUser(@user.UserId)">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a href="#" class="action-btn danger" title="Delete" onclick="deleteUser(@user.UserId, '@user.FullName')">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </div>
                                </td> *@
                            </tr>
                            avatarIndex++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 40px;">
                                <i class="fa-solid fa-users-slash" style="font-size: 48px; color: var(--text-3);"></i>
                                <p style="margin-top: 16px;">No users found. Click "Add User" to create one.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            <div class="pagination">
                <div class="entries-control">
                    <span>Show</span>
                    <select id="pageSizeSelect" onchange="changePageSize()">
                        <option value="5" selected>5</option>
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                    <span>entries</span>
                </div>

                <div class="pagination-info" id="paginationInfo">
                    Page 1 of 1 · @totalUsers total users
                </div>

                <div class="pagination-controls" id="paginationControls"></div>
            </div>
        </div>
    </main>

    <!-- Delete User Modal -->
    <div class="modal-overlay" id="deleteModal" style="display: none;">
        <div class="modal" style="background: var(--bg-card); border: 1px solid var(--crimson); border-radius: 18px; padding: 32px; width: 400px;">
            <div class="modal-header">
                <div class="modal-title" style="color: var(--crimson);">Delete User</div>
                <div class="modal-close" onclick="closeDeleteModal()" style="cursor: pointer;">✕</div>
            </div>
            <p id="deleteMessage" style="margin-bottom: 24px; color: var(--text-2);">Are you sure you want to delete this user?</p>
            <form id="deleteForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-footer" style="display: flex; justify-content: flex-end; gap: 12px;">
                    <button type="button" class="btn btn-ghost" onclick="closeDeleteModal()">Cancel</button>
                    <button type="submit" class="btn" style="background: var(--crimson); color: white;">Delete</button>
                </div>
            </form>
        </div>
    </div>

    <style>
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(6,9,19,0.85);
            backdrop-filter: blur(6px);
            z-index: 100;
            align-items: center;
            justify-content: center;
        }
        .modal-close {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: var(--bg-hover);
            color: var(--text-2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            transition: all 0.2s;
        }
        .modal-close:hover {
            border-color: var(--crimson);
            color: var(--crimson);
        }
    </style>

    <script>
            let deleteUserId = null;
            let currentRoleFilter = 'all';
            let currentPage = 1;
            let pageSize = 5;

            function getAllRows() {
                return Array.from(document.querySelectorAll('#userTableBody tr'))
                    .filter(row => row.dataset.role);
            }

            function getFilteredRows() {
                const q = document.getElementById('searchInput').value.toLowerCase().trim();

                return getAllRows().filter(row => {
                    const rowRole = (row.dataset.role || '').trim().toLowerCase();
                    const text = row.textContent.toLowerCase();

                    const roleMatch =
                        currentRoleFilter === 'all' ||
                        rowRole.includes(currentRoleFilter);

                    const searchMatch =
                        q === '' || text.includes(q);

                    return roleMatch && searchMatch;
                });
            }

            function renderPagination() {
                const allRows = getAllRows();
                const filteredRows = getFilteredRows();

                allRows.forEach(row => row.style.display = 'none');

                const totalRows = filteredRows.length;
                const totalPages = Math.max(1, Math.ceil(totalRows / pageSize));

                if (currentPage > totalPages) currentPage = totalPages;

                const start = (currentPage - 1) * pageSize;
                const end = start + pageSize;

                filteredRows.slice(start, end).forEach(row => {
                    row.style.display = '';
                });

                document.getElementById('rowCount').textContent =
                    `Showing ${totalRows} of ${allRows.length} users`;

                document.getElementById('paginationInfo').textContent =
                    `Page ${currentPage} of ${totalPages} · ${totalRows} total users`;

                const controls = document.getElementById('paginationControls');
                controls.innerHTML = '';

                const prevBtn = document.createElement('button');
                prevBtn.className = 'page-btn';
                prevBtn.innerHTML = '← Prev';
                prevBtn.disabled = currentPage === 1;
                prevBtn.onclick = function () {
                    if (currentPage > 1) {
                        currentPage--;
                        renderPagination();
                    }
                };
                controls.appendChild(prevBtn);

                for (let i = 1; i <= totalPages; i++) {
                    const btn = document.createElement('button');
                    btn.className = 'page-btn' + (i === currentPage ? ' active' : '');
                    btn.textContent = i;
                    btn.onclick = function () {
                        currentPage = i;
                        renderPagination();
                    };
                    controls.appendChild(btn);
                }

                const nextBtn = document.createElement('button');
                nextBtn.className = 'page-btn';
                nextBtn.innerHTML = 'Next →';
                nextBtn.disabled = currentPage === totalPages;
                nextBtn.onclick = function () {
                    if (currentPage < totalPages) {
                        currentPage++;
                        renderPagination();
                    }
                };
                controls.appendChild(nextBtn);
            }

            function changePageSize() {
                pageSize = parseInt(document.getElementById('pageSizeSelect').value);
                currentPage = 1;
                renderPagination();
            }

            function setFilter(el, role) {
                document.querySelectorAll('.filter-group .chip')
                    .forEach(c => c.classList.remove('active'));

                el.classList.add('active');

                currentRoleFilter = role.trim().toLowerCase();
                currentPage = 1;
                renderPagination();
            }

            function filterUsers() {
                currentPage = 1;
                renderPagination();
            }

            function exportUsers() {
                const btn = event.currentTarget;
                const orig = btn.innerHTML;

                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Exporting...';
                btn.disabled = true;

                setTimeout(() => {
                    btn.innerHTML = orig;
                    btn.disabled = false;
                    alert('Export feature coming soon!');
                }, 1800);
            }

            function deleteUser(id, name) {
                deleteUserId = id;

                document.getElementById('deleteMessage').innerHTML =
                    `Are you sure you want to delete user <strong>${name}</strong>? This action cannot be undone.`;

                document.getElementById('deleteForm').action = `/Admin/DeleteUser/${id}`;
                document.getElementById('deleteModal').style.display = 'flex';
            }

            function closeDeleteModal() {
                document.getElementById('deleteModal').style.display = 'none';
                deleteUserId = null;
            }

            function viewUser(id) {
                alert(`View user details for ID: ${id} (Coming soon!)`);
            }

            document.getElementById('deleteModal')?.addEventListener('click', function (e) {
                if (e.target === this) closeDeleteModal();
            });

            document.addEventListener('DOMContentLoaded', function () {
                renderPagination();
            });
    </script>
</body>
</html>

@functions {
    private string GetInitials(string fullName)
    {
        if (string.IsNullOrEmpty(fullName)) return "U";
        var parts = fullName.Split(' ');
        if (parts.Length >= 2)
        {
            return (parts[0][0].ToString() + parts[1][0].ToString()).ToUpper();
        }
        return fullName.Substring(0, Math.Min(2, fullName.Length)).ToUpper();
    }

    private string GetRoleClass(string roleName)
    {
        if (string.IsNullOrEmpty(roleName)) return "role-viewer";
        return roleName.ToLower() switch
        {
            "admin" => "role-admin",
            "engineer" => "role-engineer",
            "operator" => "role-operator",
            _ => "role-viewer"
        };
    }
}